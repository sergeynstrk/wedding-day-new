(function () {
    'use strict';

    var overlay = document.querySelector('.ct-modal[data-modal="what_modal"]');
    var modal = document.getElementById('ct-what-modal');

    if (!overlay || !modal || modal.classList.contains('ct-what-ready')) {
        return;
    }

    var stage = modal.querySelector('#ct-what-details-stage');
    var buttons = Array.prototype.slice.call(modal.querySelectorAll('[data-feature]'));
    var details = Array.prototype.slice.call(modal.querySelectorAll('[data-detail]'));
    var closeButton = modal.querySelector('[data-close]');
    var mobile = window.matchMedia('(max-width: 990px)');
    var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    var active = mobile.matches ? null : 'site';
    var lastActive = 'site';
    var hoverTimer = null;
    var restoreFocus = null;
    var previousOverflow = null;
    var wasOpen = false;

    function cancelHover() {
        window.clearTimeout(hoverTimer);
    }

    function selectFeature(id) {
        if (id !== null && !buttons.some(function (button) {
            return button.dataset.feature === id;
        })) {
            return;
        }

        active = id;
        if (id !== null) {
            lastActive = id;
        }

        buttons.forEach(function (button) {
            var selected = button.dataset.feature === id;
            button.classList.toggle('ct-what-is-active', selected);
            button.setAttribute('aria-expanded', String(selected));
        });

        details.forEach(function (panel) {
            var selected = panel.dataset.detail === id;
            var destination = mobile.matches && selected
                ? modal.querySelector('[data-item="' + id + '"]')
                : stage;

            panel.hidden = !selected;
            if (destination && panel.parentElement !== destination) {
                destination.appendChild(panel);
            }
        });

        modal.dispatchEvent(new CustomEvent('ct-what:featurechange', {
            bubbles: true,
            detail: {feature: id}
        }));
    }

    function onOpen() {
        restoreFocus = document.activeElement instanceof HTMLElement && document.activeElement !== document.body
            ? document.activeElement
            : null;
        previousOverflow = {
            value: document.body.style.getPropertyValue('overflow'),
            priority: document.body.style.getPropertyPriority('overflow')
        };
        document.body.style.setProperty('overflow', 'hidden');
        closeButton.focus({preventScroll: true});
        modal.dispatchEvent(new CustomEvent('ct-what:open', {bubbles: true}));
    }

    function onClose() {
        cancelHover();

        if (previousOverflow) {
            if (previousOverflow.value) {
                document.body.style.setProperty('overflow', previousOverflow.value, previousOverflow.priority);
            } else {
                document.body.style.removeProperty('overflow');
            }
            previousOverflow = null;
        }

        if (restoreFocus && restoreFocus.isConnected) {
            restoreFocus.focus({preventScroll: true});
        }
        restoreFocus = null;
        modal.dispatchEvent(new CustomEvent('ct-what:close', {bubbles: true}));
    }

    function syncOpenState() {
        var isOpen = overlay.classList.contains('active');
        if (isOpen === wasOpen) {
            return;
        }

        wasOpen = isOpen;
        overlay.setAttribute('aria-hidden', String(!isOpen));
        if (isOpen) {
            onOpen();
        } else {
            onClose();
        }
    }

    buttons.forEach(function (button) {
        button.addEventListener('pointerenter', function () {
            cancelHover();
            if (finePointer.matches && !mobile.matches) {
                hoverTimer = window.setTimeout(function () {
                    selectFeature(button.dataset.feature);
                }, 150);
            }
        });
        button.addEventListener('pointerleave', cancelHover);
        button.addEventListener('focus', function () {
            cancelHover();
            if (!mobile.matches) {
                selectFeature(button.dataset.feature);
            }
        });
        button.addEventListener('click', function () {
            cancelHover();
            var id = button.dataset.feature;
            selectFeature(mobile.matches && active === id ? null : id);
            if (mobile.matches) {
                button.scrollIntoView({block: 'nearest'});
            }
        });
    });

    overlay.addEventListener('click', function (event) {
        if (event.target === overlay) {
            closeButton.click();
        }
    });

    overlay.addEventListener('keydown', function (event) {
        if (!overlay.classList.contains('active')) {
            return;
        }

        if (event.key === 'Escape') {
            event.preventDefault();
            closeButton.click();
            return;
        }

        if (event.key !== 'Tab') {
            return;
        }

        var focusable = Array.prototype.slice.call(modal.querySelectorAll(
            'button:not([disabled]), a[href], input:not([disabled]), [tabindex="0"]'
        )).filter(function (element) {
            return element.getClientRects().length && !element.closest('[hidden]');
        });
        var first = focusable[0];
        var last = focusable[focusable.length - 1];

        if (!first) {
            return;
        }
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });

    mobile.addEventListener('change', function () {
        cancelHover();
        selectFeature(mobile.matches ? active : (active || lastActive));
    });

    new MutationObserver(syncOpenState).observe(overlay, {
        attributes: true,
        attributeFilter: ['class']
    });

    modal.classList.add('ct-what-ready');
    selectFeature(active);
    syncOpenState();

    window.CTWhatModal = Object.freeze({
        open: function (feature) {
            if (feature) {
                selectFeature(feature);
            }
            if (typeof window.modalOpen === 'function') {
                window.modalOpen($(overlay));
            } else {
                overlay.classList.add('active');
            }
        },
        close: function () {
            closeButton.click();
        },
        get isOpen() {
            return overlay.classList.contains('active');
        }
    });
})();

(function () {
    'use strict';

    var panel = document.getElementById('ct-what-detail-welcome');
    var modal = document.getElementById('ct-what-modal');
    var overlay = document.querySelector('.ct-modal[data-modal="what_modal"]');
    var stage = panel ? panel.querySelector('.ct-what-wave-demo') : null;

    if (!stage || !modal || !overlay || !modal.classList.contains('ct-what-ready')) {
        return;
    }

    var welcome = stage.querySelector('.ct-what-wave-welcome');
    var preview = stage.querySelector('.ct-what-wave-site-viewport');
    var strip = stage.querySelector('.ct-what-wave-site-strip');
    var openButton = stage.querySelector('.ct-what-wave-open-button');
    var replayButton = stage.querySelector('.ct-what-wave-replay-button');
    var nextButton = stage.querySelector('.ct-what-wave-next-button');
    var status = stage.querySelector('[role="status"]');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var animations = new Set();
    var generation = 0;
    var waitTimer;
    var finishWait;
    var previousWidth = 0;
    var previousHeight = 0;
    var wasVisible = false;

    function isVisible() {
        return overlay.classList.contains('active') && !panel.hidden && panel.isConnected;
    }

    function setState(state) {
        stage.dataset.waveState = state;
    }

    function cancelPlayback() {
        generation += 1;
        window.clearTimeout(waitTimer);
        if (finishWait) {
            finishWait(false);
        }
        finishWait = null;
        animations.forEach(function (animation) {
            animation.cancel();
        });
        animations.clear();
    }

    function reset(options) {
        options = options || {};
        cancelPlayback();
        setState('closed');
        strip.style.transform = 'translateY(0px)';
        welcome.hidden = false;
        openButton.disabled = false;
        openButton.setAttribute('aria-expanded', 'false');
        preview.setAttribute('aria-hidden', 'true');
        replayButton.hidden = true;
        nextButton.hidden = true;
        status.textContent = options.announce ? smT('ln-what-preview-001') : '';
        if (options.focus && isVisible()) {
            openButton.focus({preventScroll: true});
        }
    }

    function measure() {
        var rect = stage.getBoundingClientRect();
        if (!rect.width || !rect.height) {
            return;
        }

        var changed = Math.abs(rect.width - previousWidth) > 0.5
            || Math.abs(rect.height - previousHeight) > 0.5;
        if (changed && stage.dataset.waveState !== 'closed') {
            reset({focus: stage.contains(document.activeElement)});
        }

        previousWidth = rect.width;
        previousHeight = rect.height;
        var scale = Math.max(rect.width / 1280, rect.height / 720);
        stage.style.setProperty('--ct-what-wave-scale', String(scale));
        stage.style.setProperty('--ct-what-wave-left', ((rect.width - 1280 * scale) / 2) + 'px');
        stage.style.setProperty('--ct-what-wave-open-y', Math.min(448 * scale, rect.height - 30) + 'px');
    }

    function wait(ms) {
        return new Promise(function (resolve) {
            finishWait = resolve;
            waitTimer = window.setTimeout(function () {
                finishWait = null;
                resolve(true);
            }, ms);
        });
    }

    async function animate(element, keyframes, options) {
        var animation = element.animate(keyframes, options);
        animations.add(animation);
        try {
            await animation.finished;
            return animation;
        } catch (error) {
            animations.delete(animation);
            return null;
        }
    }

    function releaseAnimation(animation) {
        animations.delete(animation);
        animation.cancel();
    }

    function showOpened(options) {
        options = options || {};
        welcome.hidden = true;
        preview.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true');
        replayButton.hidden = false;
        nextButton.hidden = !reducedMotion.matches;
        setState('opened');
        status.textContent = reducedMotion.matches
            ? smT('ln-what-preview-002')
            : smT('ln-what-preview-003');
        if (options.focus) {
            (reducedMotion.matches ? nextButton : replayButton).focus({preventScroll: true});
        }
    }

    async function openInvitation() {
        if (!isVisible() || stage.dataset.waveState !== 'closed') {
            return;
        }

        measure();
        cancelPlayback();
        var token = generation;
        var shouldRestoreFocus = document.activeElement === openButton;
        openButton.disabled = true;
        setState('opening');

        if (reducedMotion.matches || typeof welcome.animate !== 'function') {
            showOpened({focus: shouldRestoreFocus});
            nextButton.hidden = false;
            return;
        }

        var opening = await animate(welcome, [
            {opacity: 1, transform: 'translateY(0px)'},
            {opacity: 0, transform: 'translateY(-12px)'}
        ], {duration: 520, easing: 'cubic-bezier(.2,.65,.3,1)', fill: 'forwards'});

        if (!opening || token !== generation || !isVisible()) {
            return;
        }

        showOpened({focus: shouldRestoreFocus});
        releaseAnimation(opening);
        if (!await wait(900) || token !== generation || !isVisible()) {
            return;
        }

        setState('scrolling');
        var scrolling = await animate(strip, [
            {transform: 'translateY(0px)'},
            {transform: 'translateY(-480px)'}
        ], {duration: 3500, easing: 'cubic-bezier(.3,.1,.3,1)', fill: 'forwards'});

        if (!scrolling || token !== generation || !isVisible()) {
            return;
        }

        strip.style.transform = 'translateY(-480px)';
        releaseAnimation(scrolling);
        setState('complete');
        status.textContent = smT('ln-what-preview-004');
    }

    function showNext() {
        if (!isVisible() || stage.dataset.waveState !== 'opened') {
            return;
        }
        var shouldRestoreFocus = document.activeElement === nextButton;
        cancelPlayback();
        strip.style.transform = 'translateY(-480px)';
        nextButton.hidden = true;
        setState('complete');
        status.textContent = smT('ln-what-preview-004');
        if (shouldRestoreFocus) {
            replayButton.focus({preventScroll: true});
        }
    }

    function updateVisibility() {
        var visible = isVisible();
        if (visible !== wasVisible) {
            wasVisible = visible;
            reset();
            if (visible) {
                measure();
            }
        }
    }

    openButton.addEventListener('click', openInvitation);
    welcome.addEventListener('click', function (event) {
        if (!event.target.closest('button')) {
            openInvitation();
        }
    });
    replayButton.addEventListener('click', function () {
        reset({focus: true, announce: true});
    });
    nextButton.addEventListener('click', showNext);
    reducedMotion.addEventListener('change', function () {
        reset({focus: stage.contains(document.activeElement)});
    });

    var observer = new MutationObserver(updateVisibility);
    observer.observe(panel, {attributes: true, attributeFilter: ['hidden']});
    observer.observe(overlay, {attributes: true, attributeFilter: ['class']});

    if (typeof ResizeObserver === 'function') {
        new ResizeObserver(measure).observe(stage);
    }

    window.addEventListener('resize', function () {
        if (stage.dataset.waveState !== 'closed') {
            reset({focus: stage.contains(document.activeElement)});
        }
        measure();
    });
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
            reset();
        }
    });

    reset();
    updateVisibility();
})();

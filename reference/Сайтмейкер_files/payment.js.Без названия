$(document).on('click', '#pay_more', function () {
    var pleasepay = $('.ct-pleasepay_more');
    smCheckPaymentAddress($('#domain_check-more').val()).then(function (result) {
        if (String(result[0]) !== '1') {
            pleasepay.find('[name="domain"]').addClass('ct-input_error').focus();
            return;
        }
        var domain = pleasepay.find('[name="domain"]').val();
        var email = pleasepay.find('[name="email"]').val();
        if (!paymentCheckEmail(email)) {
            pleasepay.find('[name="email"]').addClass('ct-input_error').focus();
            pleasepay.find('.ct-pay').addClass('ct-disabled');
            return;
        }
        return $.post(ajax_url, {action: 'pay_more', domain: domain, email: email}).then(function (data) {
            if (data != 0) window.location.href = data;
            else alert(smT('ln-notify-pleasepay-fail'));
        });
    }).catch(function () { alert(smT('ln-notify-pleasepay-fail')); });
});

$(document).on('input', '.ct-pleasepay_more [name="email"]', function () {
    $('.ct-pleasepay_more .ct-pay').removeClass('ct-disabled');
    $(this).removeClass('ct-input_error');
});

function smPublishPaidProject() {
    var tvid = (template_val.type_id > 1 && template_val.type_id != 5) ? 2 : template_val.type_id;
    if (typeof template_user_type == 'undefined' || template_user_type == tvid || (template_user_type == 1 && tvid == 2) || template_user_type == 5) {
        saveProject();
    } else {
        $('.ct-modal[data-modal="modal_error"]').addClass('active');
    }
}

async function validateEmailDomain(input) {

    $(input).on('input', function () {
        this.setCustomValidity('');
    });

    const $input = $(input);

    if (!checkEmail($input.val())) {
        $input.addClass('ct-input_error');
        return false;
    }

    try {
        const response = await $.ajax({
            url: '/api/checkEmailDomain/',
            method: 'POST',
            dataType: 'json',
            data: {
                email: $input.val()
            }
        });

        if (!response.valid) {
            input.setCustomValidity('Указанный домен электронной почты не существует');
            $input.focus();

            setTimeout(() => {
                input.reportValidity();
            }, 0);

            $input.addClass('ct-input_error');
            return false;
        }

        input.setCustomValidity('');
        $input.removeClass('ct-input_error');

        return true;

    } catch (e) {
        console.error('Ошибка проверки домена email', e);
        alert('Ошибка проверки домена email');
        return false;
    }
}

$('.ct-toconstr').click(async function (e) {
    e.preventDefault();
    var policyPanel=$(this).closest('.ct-planner-creation').find('[data-registration-policy]')[0];
    var policy=policyPanel&&policyPanel.querySelector('input[name="policy"]');
    if(policyPanel&&!policyPanel.hidden&&policy&&!policy.checked){
        policy.setAttribute('aria-invalid','true');
        policyPanel.querySelector('[role="alert"]').hidden=false;
        policy.focus();
        return false;
    }
    var groom = $('.ct-splash input[name="groom"]').val();
    var bride = $('.ct-splash input[name="bride"]').val();
    var main_date = $('.ct-splash input[name="main_date"]').val();
    var email = $('.ct-splash input[name="email"]').val();

    var ehash = '';
    if ($('.ct-splash input[name="ehash"]').length > 0) {
        ehash = $('.ct-splash input[name="ehash"]').val();
    }

    var pass = '';
    if ($('input[name="password"]').length > 0) {
        pass = $('input[name="password"]').val();
    }

    $.each($('.ct-splash input'),async function () {
        $(this).toggleClass('ct-input_error', !$(this).parents('.ct-input_wrapper').hasClass('ct-hidden') && $(this).val() === '');
        // console.log($(this).attr('name'))
    })


    var emailDomainValid=await validateEmailDomain($('input[name="email"]')[0]);
    if(typeof plannerCreation==='object'&&plannerCreation&&!emailDomainValid)return false;

    if ($('.ct-splash input.ct-input_error').length === 0) {
        // 28.10.2026: owned Planner entry fills the existing project form, never registers another account.
        if(typeof plannerCreation==='object'&&plannerCreation){
            if(psending)return false;
            psending=true;$('body').addClass('sending');
            try{
                if(plannerCreation.needsEmail){
                    var completion=await $.ajax({url:'/register/',type:'POST',dataType:'json',data:{submit:'true',usertype:'client',noemail:'1',planner_partial:'1',planner_csrf:plannerCreation.csrf,firstname:bride,email:email,client_name_wedding:groom+' и '+bride,datewedding:main_date,lost:'',uid:'',profile:''}});
                    if(!completion||completion.register!=='ok')throw Error(completion&&completion.error||'Не удалось сохранить почту. Проверьте, не занята ли она другим аккаунтом.');
                    plannerCreation.needsEmail=false;
                }
                var created=await $.post(ajax_url,{action:'start',groom:groom,bride:bride,main_date:main_date,email:email,planner_creation:'1',planner_csrf:plannerCreation.csrf});
                if(String(created).trim()!=='ok')throw Error('Не удалось сохранить приглашение. Проверьте данные и попробуйте снова.');
                window.location.href='/sitemaker/?planner=1';
            }catch(failure){alert(failure&&failure.message||'Не удалось создать приглашение. Попробуйте снова.');}
            finally{psending=false;$('body').removeClass('sending');}
            return false;
        }
        $('body').toggleClass('sending', true);
        if (pass != '') {
            if (!psending) {
                psending = true;
                console.log({
                    action: 'auth',
                    password: pass,
                    ehash: ehash,
                    email: email
                })
                $.post(ajax_url, {
                    action: 'auth',
                    password: pass,
                    ehash: ehash,
                    email: email
                }, function (data) {
                    if (data == 'auth') {
                        $('body').toggleClass('sending', false);
                        psending = false;
                        alert(constr_terms['ln-notify-error']);
                    } else {
                        var d = $.parseJSON(data);
                        if (d[0] == 'ok' && d.length > 1) {
                            if (d[1] == '/sitemaker/' && typeof (_ym) != 'undefined' && _ym != 0) {
                                ym(_ym, 'reachGoal', 'sitemakerReg');
                            }

                            window.location.href = d[1];
                        }
                    }
                })
            }
        } else {    // первый этап
            var oper = 'start';
            var wtg = 0;
            if ($('.ct-splash input[name="bride"]').parents('.ct-input_wrapper').hasClass('ct-hidden')) {
                oper = 'restart';
            } else {
                wtg = $('.ct-telegram').length > 0 && $('.ct-telegram input').is(':checked');
            }
            console.log(wtg)
            console.log(oper);

            if (!psending) {
                psending = true;
                console.log(oper)
                $.post(ajax_url,
                    {
                        action: oper,
                        groom: groom,
                        wtg: Number(wtg),
                        bride: bride,
                        main_date: main_date,
                        email: email
                    }, function (data) {
                        if (data == 'auth') {
                            psending = false;
                            $('body').toggleClass('sending', false);
                            alert(constr_terms['ln-notify-error']);
                        } else {
                            $('body').toggleClass('sending', false);
                            if (wtg) {
                                initTelegramAuth('registration');
                                psending = false;
                                return false;
                            } else {
                                if (data == 'ok') {
                                    window.location.href = '/sitemaker/';
                                } else if (data == 'newuser') {
                                    $('.ct-splash').removeClass('active');
                                    window.location.href = '/sitemaker/';
                                } else if (data == 'nouser') {
                                    alert(constr_terms['ln-auth-email-error']);
                                } else {
                                    window.location.href = '/sitemaker/?e=' + data;
                                }
                            }
                        }
                    })
            }
        }
    }

    return false;

})

